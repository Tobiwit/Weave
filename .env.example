# Optional. Enables live song search and community tags from Last.fm.
# Without it, Weave uses its local development catalogue and stays fully usable.
#
# NOTE: this is a static browser app. Anything prefixed with VITE_ is compiled
# into the bundle and is visible to anyone who opens devtools. Treat this key as
# public. If you need a real secret, put a proxy in front of the provider and
# point the adapter in src/services/lastfm/client.ts at it instead.
VITE_LASTFM_API_KEY=

# Optional. Enables accounts (library sync) and Spotify playlist import.
# Both are additive: with these blank, Weave stays local-only and fully usable.
# The anon key is designed to be public; row-level security is what protects
# data, so never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Enables Spotify playlist import.
# This is a PKCE client id and is public by design - there is no secret.
# Register the redirect URI in the Spotify dashboard exactly as:
#   http://127.0.0.1:5173/spotify-callback     (development)
#   https://your-domain/spotify-callback       (production)
# Spotify no longer accepts "localhost"; use the 127.0.0.1 loopback address.
VITE_SPOTIFY_CLIENT_ID=
